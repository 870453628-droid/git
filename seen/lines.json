[
  { "t0": 0.8,  "t1": 4.2,  "zh": "小时候，所有人都看着我。" },
  { "t0": 4.8,  "t1": 8.4,  "zh": "我以为，那就是特别。" },
  { "t0": 10.0, "t1": 13.6, "zh": "后来，灯走了，我就追。" },
  { "t0": 15.0, "t1": 18.6, "zh": "人散了，我不知道自己在哪。" },
  { "t0": 19.8, "t1": 22.6, "zh": "我开始追一个数字。" },
  { "t0": 27.2, "t1": 30.6, "zh": "追到最后，忘了自己想做什么。" },
  { "t0": 32.2, "t1": 35.6, "zh": "那就不看了，一个人走。" },
  { "t0": 38.0, "t1": 42.2, "zh": "我以为，长大就是不再在乎。" },
  { "t0": 47.8, "t1": 51.2, "zh": "慢慢地，脚步稳了。" },
  { "t0": 53.0, "t1": 56.6, "zh": "有人鼓掌，有人陪我走一段。" },
  { "t0": 57.6, "t1": 59.6, "zh": "我笑了，又慌了——" },
  { "t0": 59.8, "t1": 62.6, "zh": "我怎么还是这么在意？" },
  { "t0": 64.6, "t1": 67.2, "zh": "我不想再否认了。" },
  { "t0": 68.0, "t1": 71.0, "zh": "想被看见，也怕孤单。" },
  { "t0": 72.0, "t1": 76.0, "zh": "可就算没人看，路还是要走。" },
  { "t0": 78.2, "t1": 81.0, "zh": "我还是想被看见。" },
  { "t0": 81.6, "t1": 85.6, "zh": "但这一次，我想先把故事讲完。" }
]
