[
  { "t0": 5.0,   "t1": 8.4,   "zh": "小时候，所有人都看着我。" },
  { "t0": 10.2,  "t1": 12.4,  "zh": "我喜欢被看见。" },
  { "t0": 17.0,  "t1": 20.2,  "zh": "后来，我的光越来越小。" },
  { "t0": 27.4,  "t1": 30.4,  "zh": "我追过去，它就暗了。" },
  { "t0": 31.4,  "t1": 34.8,  "zh": "我想与众不同，想被更多人看见。" },
  { "t0": 36.4,  "t1": 39.4,  "zh": "可看我的人，越来越少。" },
  { "t0": 40.8,  "t1": 43.4,  "zh": "屏幕前，也有光。" },
  { "t0": 48.4,  "t1": 51.2,  "zh": "可这束光，也暗了。" },
  { "t0": 58.4,  "t1": 61.4,  "zh": "身边走过的人，都比我亮。" },
  { "t0": 62.8,  "t1": 66.2,  "zh": "我也想那样亮，可我做不到。" },
  { "t0": 72.6,  "t1": 75.0,  "zh": "那就不追了。" },
  { "t0": 76.0,  "t1": 79.6,  "zh": "不再等别人，把光打在我身上。" },
  { "t0": 81.0,  "t1": 84.2,  "zh": "我开始做自己想做的事。" },
  { "t0": 87.0,  "t1": 91.0,  "zh": "更亮的光经过，我看一眼，又低下头。" },
  { "t0": 92.8,  "t1": 95.8,  "zh": "有一天，光照到了我身上。" },
  { "t0": 96.6,  "t1": 100.2, "zh": "我很开心，又有点怕——我果然还是在意。" },
  { "t0": 101.0, "t1": 104.0, "zh": "光有时消失，有时更亮。" },
  { "t0": 104.8, "t1": 107.8, "zh": "心情跟着变，可我一直没变。" },
  { "t0": 108.8, "t1": 111.8, "zh": "原来，我从没想躲在后面。" },
  { "t0": 112.8, "t1": 116.2, "zh": "我想明白了：我还是想被看见。" },
  { "t0": 117.0, "t1": 121.4, "zh": "就算没人看见，我也会继续往前走。" }
]
