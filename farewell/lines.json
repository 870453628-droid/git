[
  { "t0": 0.00,   "t1": 1.70,   "text": "“看缘分吧。”" },
  { "t0": 1.70,   "t1": 3.95,   "text": "中国人似乎很喜欢这句话，" },
  { "t0": 3.95,   "t1": 6.30,   "text": "我起初并未觉得有什么特别。" },
  { "t0": 6.30,   "t1": 8.15,   "text": "直到后来朋友提起她，" },
  { "t0": 8.15,   "t1": 10.65,  "text": "惋惜地叹道：“你们俩啊，" },
  { "t0": 10.65,  "t1": 12.40,  "text": "终究是有缘无分，" },
  { "t0": 12.40,  "t1": 14.25,  "text": "实在太可惜了。”" },
  { "t0": 14.25,  "t1": 16.20,  "text": "可怎样才算有缘分？" },
  { "t0": 16.20,  "t1": 17.95,  "text": "我自己也想不明白。" },
  { "t0": 17.95,  "t1": 22.10,  "text": "若是真有缘，为何最终走到了不再联系的结局；" },
  { "t0": 22.10,  "t1": 23.65,  "text": "若当真无缘，" },
  { "t0": 23.65,  "t1": 27.40,  "text": "那整整三年无话不说的朝夕相处，又算什么。" },
  { "t0": 27.40,  "t1": 29.65,  "text": "那天我们并肩坐在高台上，" },
  { "t0": 29.65,  "t1": 32.10,  "text": "望着班级，望着操场。" },
  { "t0": 32.10,  "t1": 36.15,  "text": "没有人说话，我们像自然一样自然，安静不语。" },
  { "t0": 36.15,  "t1": 38.55,  "text": "坐在身边的她又在想些什么呢？" },
  { "t0": 38.55,  "t1": 40.90,  "text": "我心里好奇，但没有问。" },
  { "t0": 40.90,  "t1": 43.15,  "text": "我以为日子可以一直重复，" },
  { "t0": 43.15,  "t1": 45.50,  "text": "还有明天，但我错了。" },
  { "t0": 45.50,  "t1": 48.45,  "text": "借过的作业、送出的礼物、" },
  { "t0": 48.45,  "t1": 51.75,  "text": "说过的话语，早就是此生的最后一次。" },
  { "t0": 51.75,  "t1": 54.25,  "text": "那天究竟是沉默还是说了些什么，" },
  { "t0": 54.25,  "t1": 56.65,  "text": "如今竟一点也记不真切了，" },
  { "t0": 56.65,  "t1": 59.25,  "text": "只记得风很轻，太阳很暖。" },
  { "t0": 59.25,  "t1": 61.35,  "text": "我甚至无法纪念那一天，" },
  { "t0": 61.35,  "t1": 63.05,  "text": "身处其中的时候，" },
  { "t0": 63.05,  "t1": 66.00,  "text": "只觉得一切都平凡得如同寻常日子。" },
  { "t0": 66.00,  "t1": 69.50,  "text": "前些日子去浙江，车窗外群山绵延。" },
  { "t0": 69.50,  "t1": 74.40,  "text": "山色极美，风晴雨霁，平林烟霭，云遏千里。" },
  { "t0": 74.40,  "t1": 77.45,  "text": "天如长海柔波，山如凝固海浪。" },
  { "t0": 77.45,  "t1": 79.95,  "text": "可我与那些山只是萍水相逢，" },
  { "t0": 79.95,  "t1": 82.40,  "text": "看一眼，便再无下次。" },
  { "t0": 82.40,  "t1": 85.25,  "text": "我忽然想起：“当时轻别意中人，" },
  { "t0": 85.25,  "t1": 87.40,  "text": "山长水远知何处。”" },
  { "t0": 87.40,  "t1": 90.75,  "text": "辗转四季，有些人一旦在人海走散，" },
  { "t0": 90.75,  "t1": 92.65,  "text": "真的就再也见不到了。" },
  { "t0": 92.65,  "t1": 96.40,  "text": "山与天之间，或许曾悬着一根极细的弦。" },
  { "t0": 96.40,  "t1": 100.20, "text": "后来弦断了，山塌成谷，天裂成霞。" },
  { "t0": 100.20, "t1": 102.25, "text": "人人都说天地无情，" },
  { "t0": 102.25, "t1": 104.65, "text": "那根弦却从未真正消失，" },
  { "t0": 104.65, "t1": 107.20, "text": "它化成了你抬头望见的那片云，" },
  { "t0": 107.20, "t1": 109.40, "text": "和我低头淋到的那场雨。" },
  { "t0": 109.40, "t1": 111.90, "text": "云往山去，雨向天回，" },
  { "t0": 111.90, "t1": 115.90, "text": "一来一往之间，盛满了人间所有说不出口、" },
  { "t0": 115.90, "t1": 117.55, "text": "放不下的心事。" },
  { "t0": 117.55, "t1": 121.35, "text": "青春总会退场，日光依旧慷慨地照向大地，" },
  { "t0": 121.35, "t1": 123.10, "text": "生活仍在继续。" },
  { "t0": 123.10, "t1": 124.65, "text": "盛夏的午后，" },
  { "t0": 124.65, "t1": 127.90, "text": "往盛满冰块的杯中倒入整罐橙子味汽水，" },
  { "t0": 127.90, "t1": 130.40, "text": "坐在清凉的房间里一饮而尽，" },
  { "t0": 130.40, "t1": 133.55, "text": "寒意与甜味漫过喉咙，恍如隔世。" }
]
